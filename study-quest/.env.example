# ---------------------------------------------------------------------------
# Study Quest environment variables
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Firebase web app config (public; from Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (SERVER ONLY, secret). Paste the whole service-account JSON
# on one line, or base64-encode it. Firebase console > Project settings >
# Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- AI planner (SERVER ONLY, secret). Leave empty to use the built-in sample planner.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high
# AI_PROVIDER=auto               # auto | anthropic | mock
# AI_DAILY_LIMIT=25              # plan generations per user per day

# --- Local development against the Firebase Emulator Suite (no real project needed)
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-study-quest
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
