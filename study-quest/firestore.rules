rules_version = '2';

// Study Quest security model
// - Every document lives under /users/{uid}/... and can only be READ by that user.
// - The browser never writes. All writes (quests, progress, XP, streaks,
//   achievements, settings, notes) go through the app's server API, which
//   verifies the Firebase ID token and uses the Admin SDK (which bypasses rules)
//   inside validated transactions. This makes XP, streaks and achievements
//   impossible to tamper with from the client.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /{document=**} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
