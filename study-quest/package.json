{
  "name": "study-quest",
  "version": "1.0.0",
  "private": true,
  "description": "Study Quest - an AI-planned, calmly gamified study companion",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-study-quest",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-study-quest \"vitest run --config vitest.integration.config.mts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-study-quest \"playwright test --trace off\"",
    "dev:emulated": "firebase emulators:exec --only auth,firestore --project demo-study-quest \"next dev\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.77.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.6",
    "partial-json": "^0.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.37.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
